PORT=4000
REDIS_URL=
LOCK_TTL_SECONDS=60

# Store mode: "database" or "memory"
STORE_MODE=database

# MariaDB/MySQL connection string for Prisma
DATABASE_URL=
# Shadow DB for Prisma Migrate (recommended when DB user cannot CREATE DATABASE globally)
SHADOW_DATABASE_URL=

# Seed baseline records on boot when in database mode
DB_SEED_ON_BOOT=true

# Google OAuth for real Gmail channel connect flow
# Redirect URI must exactly match one added in Google Cloud OAuth credentials.
# Example: http://localhost:3000/settings/connect-channel
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_WATCH_LABEL_IDS=INBOX
